{
  "name": "golf-swing-analyzer",
  "private": true,
  "version": "0.1.4",
  "description": "Desktop golf swing capture and 3D pose analysis",
  "author": "Greg Brown",
  "repository": {
    "type": "git",
    "url": "https://github.com/greg01491/golf-swing-analyzer.git"
  },
  "type": "module",
  "main": "electron/main.js",
  "build": {
    "appId": "com.gregbrown.golfswinganalyzer",
    "productName": "Golf Swing Analyzer",
    "artifactName": "Golf-Swing-Analyzer-Setup-${version}.${ext}",
    "files": [
      "dist/**",
      "electron/**"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/golf-sim-backend",
        "to": "backend"
      },
      {
        "from": "../config/config.yaml",
        "to": "defaults/config.yaml"
      },
      {
        "from": "../backend/runtime-models",
        "to": "models/rtmlib"
      }
    ],
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "greg01491",
      "repo": "golf-swing-analyzer"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Golf Swing Analyzer"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "backend:build": "cd ../backend && python prepare_models.py && python -m PyInstaller --noconfirm golf_sim_backend.spec",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron:dev": "concurrently -k -n VITE,ELECTRON -c blue,green \"vite\" \"wait-on tcp:5173 && electron .\"",
    "electron:build": "npm run build && npm run backend:build && electron-builder --publish never"
  },
  "dependencies": {
    "@types/three": "^0.185.1",
    "electron-updater": "^6.8.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "oxlint": "^1.71.0",
    "prettier": "^3.9.5",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "wait-on": "^9.0.10"
  }
}
